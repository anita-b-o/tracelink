COMPOSE_PROJECT_NAME=tracelink

FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_DB=tracelink
POSTGRES_USER=tracelink
POSTGRES_PASSWORD=tracelink_dev

BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_GRAPH_MAX_NODES=250
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver,test
LOG_LEVEL=INFO
APP_ENV=development
AUTH_JWT_SECRET=development-jwt-secret-change-me-32-bytes
AUTH_TOKEN_PEPPER=development-token-pepper-change-me-32
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
DEV_BOOTSTRAP_EMAIL=dev@tracelink.local
DEV_BOOTSTRAP_PASSWORD=tracelink-development
METRICS_BEARER_TOKEN=development-metrics-token
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
MAX_REQUEST_BODY_BYTES=262144
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=3
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=300
CELERY_TASK_TIME_LIMIT_SECONDS=330
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_SECONDS=60
RESEARCH_TASK_MAX_ATTEMPTS=3
FAKE_RESEARCH_DELAY_MS=25
CELERY_TRANSPORT_MAX_RETRIES=3
RESEARCH_HTTP_TIMEOUT_SECONDS=10
RESEARCH_HTTP_MAX_RESPONSE_BYTES=5000000
RESEARCH_HTTP_MAX_REDIRECTS=5
RESEARCH_HTTP_USER_AGENT=TraceLink/0.1 ResearchConnector
RESEARCH_WEB_SEARCH_MAX_RESULTS=10
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_CONNECTOR_REQUESTS_PER_SECOND=2
ENTITY_EXTRACTION_CHUNK_SIZE=4000
ENTITY_EXTRACTION_CHUNK_OVERLAP=300
ENTITY_RESOLUTION_AUTO_MATCH_THRESHOLD=0.90
ENTITY_RESOLUTION_POSSIBLE_MATCH_THRESHOLD=0.65
RELATIONSHIP_AUTO_ACCEPT_THRESHOLD=0.90
RELATIONSHIP_POSSIBLE_THRESHOLD=0.65
RELATIONSHIP_MAX_CANDIDATES_PER_DOCUMENT=100
RAG_CHUNK_SIZE=1600
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=10
RAG_SEMANTIC_WEIGHT=0.70
RAG_LEXICAL_WEIGHT=0.30
RAG_MIN_RETRIEVAL_SCORE=0.20
RAG_MIN_EVIDENCE_COUNT=1
RAG_MAX_CONTEXT_CHARS=24000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=fake
LLM_MODEL=gpt-5.6-luna
# OPENAI_API_KEY=  # Required only when EMBEDDING_PROVIDER or LLM_PROVIDER is openai.
